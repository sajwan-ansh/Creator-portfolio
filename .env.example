# Creator Portfolio Environment Variables Template
# Copy this file to .env and configure your production credentials.

# --------------------------------------------------------
# 1. Storage Provider Configuration ('mock' | 'cloudinary' | 'supabase')
# --------------------------------------------------------
VITE_STORAGE_PROVIDER=mock

# Cloudinary Cloud Storage Credentials (Optional for production cloud uploads)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Supabase Credentials (Optional for Supabase storage/auth integration)
VITE_SUPABASE_URL=https://your-app.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# --------------------------------------------------------
# 2. Contact Submission Endpoint (Formspree or Custom API)
# --------------------------------------------------------
VITE_CONTACT_ENDPOINT=https://formspree.io/f/your_form_id
VITE_FORMSPREE_ID=your_form_id

# --------------------------------------------------------
# 3. Development Creator Authentication
# --------------------------------------------------------
VITE_DEV_ADMIN_PIN=1234
